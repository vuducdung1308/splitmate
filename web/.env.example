# 56 = BSC mainnet, 97 = BSC testnet, 31337 = local Hardhat
NEXT_PUBLIC_CHAIN_ID=97
# Optional custom RPCs (server-side ones can be private)
NEXT_PUBLIC_BSC_RPC=
NEXT_PUBLIC_BSC_TESTNET_RPC=
BSC_RPC=
BSC_TESTNET_RPC=
# Claude API for the expense agent (falls back to a simple offline parser if unset)
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5
# Reference rate shown to users when converting VND to USDT
REF_VND_PER_USDT=26000
